            "params": [
              {
                "name": "flowId",
                "value": "",
                "type": "path",
                "description": "The published flow id."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a published workflow. Provide input arguments as an array of name/value pairs and choose sync (blocking) or async (fire-and-forget) execution mode."
        }
      ]
    }
  ],
  "bundled": true
}