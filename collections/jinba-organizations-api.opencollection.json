              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update organization"
        },
        {
          "info": {
            "name": "Delete organization",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.jinba.dev/orgs/:orgId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete organization"
        }
      ]
    }
